APP_ENV=development
SECRET_KEY=resumeiq-super-secret-key-change-in-production

# Mode configuration: "local" or "aws"
STORAGE_MODE=local
DATABASE_MODE=sqlite

# Local paths
UPLOAD_FOLDER=storage/uploads
GENERATED_FOLDER=storage/generated
DATABASE_PATH=data/resumeiq.db
MAX_UPLOAD_SIZE_MB=5

# AWS Mode Settings (Optional for Local Mode)
AWS_REGION=us-east-1
AWS_S3_BUCKET=resumeiq-uploads-bucket
AWS_DYNAMODB_TABLE=resumeiq-analyses
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
